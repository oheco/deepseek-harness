# App-owned dependency location and integrity checks. The released SDK's own
# CMakeLists.txt is copied unchanged and receives these explicit prefixes.
set(DSH_BROKER_DEPENDENCY_ROOT "${CMAKE_CURRENT_LIST_DIR}/tpr/broker-native-arm64")
if(DEFINED OHOS_ARCH AND NOT OHOS_ARCH STREQUAL "arm64-v8a")
  message(FATAL_ERROR "The broker native payload requires OHOS arm64-v8a")
endif()
if(NOT EXISTS "${DSH_BROKER_DEPENDENCY_ROOT}/SHA256SUMS")
  message(FATAL_ERROR "Missing broker native payload; run prepare_native.py offline on HarmonyOS")
endif()
file(STRINGS "${DSH_BROKER_DEPENDENCY_ROOT}/SHA256SUMS" _broker_checksums)
foreach(_record IN LISTS _broker_checksums)
  if(NOT _record MATCHES "^([0-9a-f]+)  ([a-zA-Z0-9_./-]+)$")
    message(FATAL_ERROR "Invalid broker input checksum record")
  endif()
  set(_expected "${CMAKE_MATCH_1}")
  set(_name "${CMAKE_MATCH_2}")
  string(LENGTH "${_expected}" _length)
  if(NOT _length EQUAL 64 OR _name MATCHES "(^/|[.][.])" OR NOT EXISTS "${DSH_BROKER_DEPENDENCY_ROOT}/${_name}")
    message(FATAL_ERROR "Missing or invalid broker payload input: ${_name}")
  endif()
  file(SHA256 "${DSH_BROKER_DEPENDENCY_ROOT}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Broker payload checksum mismatch: ${_name}")
  endif()
endforeach()
foreach(dep xquic-static juice cjson curl ssl crypto)
  if(NOT EXISTS "${DSH_BROKER_DEPENDENCY_ROOT}/lib/lib${dep}.a")
    message(FATAL_ERROR "Missing broker native input lib${dep}.a; run prepare_native.py offline on HarmonyOS")
  endif()
endforeach()
set(OB_NATIVE_PREFIX "${DSH_BROKER_DEPENDENCY_ROOT}" CACHE PATH "App native dependency prefix" FORCE)
set(OB_CURL_PREFIX "${DSH_BROKER_DEPENDENCY_ROOT}" CACHE PATH "App curl dependency prefix" FORCE)
set(OB_CXX_RUNTIME "c++" CACHE STRING "HarmonyOS native C++ runtime" FORCE)
# HarmonyOS puts pthreads in libc and omits pthread_cancel. Prefer the compiler's
# -pthread check so FindThreads does not require that unsupported libc function.
set(THREADS_PREFER_PTHREAD_FLAG TRUE)
# Pin validated archives explicitly: Hvigor re-roots find_library paths to its
# SDK sysroot. Refresh every configure so relocated projects keep current inputs.
foreach(dep xquic juice cjson curl ssl crypto)
  if(dep STREQUAL "xquic")
    set(_broker_archive "xquic-static")
  else()
    set(_broker_archive "${dep}")
  endif()
  set(OB_${dep}_LIB "${DSH_BROKER_DEPENDENCY_ROOT}/lib/lib${_broker_archive}.a"
      CACHE FILEPATH "Verified App broker dependency" FORCE)
endforeach()
