/** Installed Web connection; regenerated by package-app-project.py for another user home. */
export class RuntimeDefaults {
  static homeDir: string = '/storage/Users/currentUser';
  static runLogName: string = 'dsh-0.1.7-run.log';
  static runCommand: string = 'dsh web --host 127.0.0.1 --port 0 --no-open > /storage/Users/currentUser/Documents/dsh-0.1.7-run.log 2>&1 &';
}
